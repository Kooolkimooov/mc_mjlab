{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_prose.py\"",
            "timeout": 15,
            "statusMessage": "Checking prose budget"
          }
        ]
      }
    ]
  }
}
